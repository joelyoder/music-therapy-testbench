# Copy to .streamlit/secrets.toml for local runs, or paste into your host's "Secrets" settings.
# NEVER commit the real secrets.toml.

openrouter_api_key = "sk-or-..."

# Postgres connection string (Neon/Supabase). Without it the app uses a local SQLite file,
# which is wiped on hosts with ephemeral disks (e.g. Streamlit Community Cloud).
database_url = "postgresql://user:pass@host/dbname?sslmode=require"

# Only these Google accounts can get in. Empty/missing = nobody (fails closed).
allowed_emails = ["you@gmail.com", "teammate@gmail.com"]

# Safety rails
max_runs_per_user_per_day = 100
max_tokens_cap = 4000
# Hide OpenRouter models whose output price exceeds this (USD per 1M tokens); users can opt in via a checkbox
max_output_price_per_m = 20

# Google sign-in (Streamlit built-in OIDC). See README for how to get client_id/secret.
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "a-long-random-string"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Fallback if you skip Google sign-in: a shared password (remove the [auth] section above).
# app_password = "choose-something-long"
